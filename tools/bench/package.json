{
  "name": "@cube/bench",
  "version": "0.0.0",
  "private": true,
  "description": "CLI benchmarks over a fixed seeded scramble set for both engines; writes JSON and a Markdown table.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "bench": "node src/main.ts",
    "bench:optimal": "node src/optimal.ts",
    "bench:four": "node src/four.ts",
    "bench:summary": "node src/summary.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@cube/core": "workspace:*",
    "@cube/solver-ts": "workspace:*",
    "@cube/solver-wasm": "workspace:*"
  }
}
